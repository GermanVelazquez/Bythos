<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema oscuro único; el Material del framework es idéntico en API 26-36 (DeviceDefault no lo es). -->
    <style name="Tema.Bythos" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_alt</item>
        <item name="android:navigationBarColor">@color/bg_alt</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_dim</item>
        <item name="android:colorAccent">@color/ink_accent</item>
        <item name="android:colorControlActivated">@color/ink_accent</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:buttonStyle">@style/Boton.Primario</item>
        <item name="android:alertDialogTheme">@style/Tema.Bythos.Dialogo</item>
    </style>

    <style name="Tema.Bythos.Dialogo" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fondo_dialogo</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorAlertDialogListItem">@color/ink</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/objetivo_tactil</item>
        <item name="android:buttonBarButtonStyle">@style/Boton.Secundario</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Boton" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">@dimen/objetivo_tactil</item>
        <item name="android:minWidth">@dimen/objetivo_tactil</item>
        <item name="android:textSize">@dimen/texto_boton</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>
    <style name="Boton.Primario">
        <item name="android:background">@drawable/boton_primario</item>
        <item name="android:textColor">@color/texto_boton_primario</item>
    </style>
    <style name="Boton.Secundario">
        <item name="android:background">@drawable/boton_secundario</item>
        <item name="android:textColor">@color/texto_boton_secundario</item>
    </style>

    <style name="TextAppearance.Bythos" parent="@android:style/TextAppearance.Material" />
    <style name="TextAppearance.Bythos.Titulo">
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Bythos.Panel">
        <item name="android:textSize">@dimen/texto_panel</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Bythos.Cuerpo">
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Bythos.Tenue">
        <item name="android:textSize">@dimen/texto_tenue</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="TextAppearance.Bythos.Micro">
        <item name="android:textSize">@dimen/texto_micro</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
</resources>
